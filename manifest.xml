<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="MailApp">
<Id>9d0d02c8-f237-4aa8-8c1a-11427a581cb8</Id>
<Version>1.0.0.1</Version>
<ProviderName>CPL Marketing</ProviderName>
<DefaultLocale>nl-NL</DefaultLocale>
<DisplayName DefaultValue="CPL CRM"/>
<Description DefaultValue="Bekijk en beheer CRM-contacten direct vanuit Outlook"/>
<IconUrl DefaultValue="https://placehold.co/80x80/0078d4/ffffff.png"/>
<HighResolutionIconUrl DefaultValue="https://placehold.co/80x80/0078d4/ffffff.png"/>
<SupportUrl DefaultValue="https://cpl-marketing.base44.app"/>
<AppDomains>
<AppDomain>https://cpl-marketing.base44.app</AppDomain>
<AppDomain>https://leondenboe.github.io</AppDomain>
</AppDomains>
<Hosts>
<Host Name="Mailbox"/>
</Hosts>
<Requirements>
<Sets>
<!--  FIX: was "MailBox" (hoofdletter B) — dit is case-sensitive  -->
<Set Name="Mailbox" MinVersion="1.1"/>
</Sets>
</Requirements>
<FormSettings>
<Form xsi:type="ItemRead">
<DesktopSettings>
<SourceLocation DefaultValue="https://leondenboe.github.io/Outlookkopp.-salesapp/taskpane.html"/>
<RequestedHeight>450</RequestedHeight>
</DesktopSettings>
</Form>
</FormSettings>
<Permissions>ReadItem</Permissions>
<Rule xsi:type="RuleCollection" Mode="Or">
<Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
</Rule>
<DisableEntityHighlighting>false</DisableEntityHighlighting>
<VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
<Requirements>
<bt:Sets DefaultMinVersion="1.3">
<bt:Set Name="Mailbox"/>
</bt:Sets>
</Requirements>
<Hosts>
<Host xsi:type="MailHost">
<DesktopFormFactor>
<!--  FIX: FunctionFile wijst nu naar commands.js (JS-bestand), niet naar HTML  -->
<FunctionFile resid="Commands.Url"/>
<ExtensionPoint xsi:type="MessageReadCommandSurface">
<OfficeTab id="TabDefault">
<Group id="msgReadGroup">
<Label resid="GroupLabel"/>
<Control xsi:type="Button" id="msgReadOpenPaneButton">
<Label resid="TaskpaneButton.Label"/>
<Supertip>
<Title resid="TaskpaneButton.Label"/>
<Description resid="TaskpaneButton.Tooltip"/>
</Supertip>
<Icon>
<!--  FIX: iconen gehost op eigen GitHub Pages domein  -->
<bt:Image size="16" resid="Icon.16x16"/>
<bt:Image size="32" resid="Icon.32x32"/>
<bt:Image size="80" resid="Icon.80x80"/>
</Icon>
<Action xsi:type="ShowTaskpane">
<TaskpaneId>ButtonId1</TaskpaneId>
<SourceLocation resid="Taskpane.Url"/>
</Action>
</Control>
</Group>
</OfficeTab>
</ExtensionPoint>
</DesktopFormFactor>
</Host>
</Hosts>
<Resources>
<bt:Images>
<bt:Image id="Icon.16x16" DefaultValue="https://placehold.co/16x16/0078d4/ffffff.png"/>
<bt:Image id="Icon.32x32" DefaultValue="https://placehold.co/32x32/0078d4/ffffff.png"/>
<bt:Image id="Icon.80x80" DefaultValue="https://placehold.co/80x80/0078d4/ffffff.png"/>
</bt:Images>
<bt:Urls>
<!--  FIX: Commands.Url wijst naar commands.js (apart JS-bestand vereist door Office)  -->
<bt:Url id="Commands.Url" DefaultValue="https://leondenboe.github.io/Outlookkopp.-salesapp/commands.js"/>
<bt:Url id="Taskpane.Url" DefaultValue="https://leondenboe.github.io/Outlookkopp.-salesapp/taskpane.html"/>
</bt:Urls>
<bt:ShortStrings>
<bt:String id="GroupLabel" DefaultValue="CPL CRM"/>
<bt:String id="TaskpaneButton.Label" DefaultValue="CRM Contact"/>
</bt:ShortStrings>
<bt:LongStrings>
<bt:String id="TaskpaneButton.Tooltip" DefaultValue="Bekijk CRM-informatie over de afzender van deze e-mail"/>
</bt:LongStrings>
</Resources>
</VersionOverrides>
</OfficeApp>
